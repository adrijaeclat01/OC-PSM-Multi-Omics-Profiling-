       y = expression("Mean " * -log[10](p)~"(up) " - "Mean " * -log[10](p)~"(down)"))

ggsave("Biological_Shift_Plot_NORMALIZED.png", p_shift_norm, width = 10, height = 6, dpi = 600, bg = "white")

