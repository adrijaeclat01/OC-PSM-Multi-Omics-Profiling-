# ============================================================
# 3. REAL, DATA-DERIVED BIOLOGICAL SHIFT PLOT
#
# Instead of hardcoded scores, this computes a directional score per
# theme from your actual up_reac / down_reac / up_kegg / down_kegg
# enrichment results (combining REAC + KEGG sources for theme coverage).
#
# Method: for each theme, define a set of matching term_name keywords.
# Score = sum(-log10(p_value)) for UP-side matching terms
#       - sum(-log10(p_value)) for DOWN-side matching terms
# This makes the bar direction and magnitude a real function of your
# enrichment output, not an illustration.
# ============================================================

# Combine up and down REAC + KEGG results into one searchable pool each
up_pool   <- bind_rows(up_reac, up_kegg)
down_pool <- bind_rows(down_reac, down_kegg)

# Define keyword sets per theme (edit these if your term_names differ)
theme_keywords <- list(
  "Translation"                = c("[Tt]ranslat", "ribosom", "peptide chain", "NMD", "[Nn]onsense"),
  "RNA Processing"             = c("RNA processing", "spliceosom", "mRNA splicing", "snRNP"),
  "Oxidative Phosphorylation"  = c("[Oo]xidative phosphorylation", "[Ee]lectron transport"),
  "Mitochondrial Metabolism"   = c("[Mm]itochondria", "TCA cycle", "[Cc]itrate cycle", "[Pp]yruvate", "fatty acid"),
  "ECM Remodeling"             = c("extracellular matrix", "ECM", "collagen", "[Ff]ocal adhesion", "[Pp]roteoglycans"),
  "Immune Response"            = c("immune", "interferon", "complement", "cytokine"),
  "Coagulation"                = c("[Cc]oagulation", "[Pp]latelet", "[Hh]emostasis"),
  "Oxidative Stress"           = c("oxidative stress", "reactive oxygen", "[Rr]edox")
)

score_theme <- function(pool, keywords) {
  if (nrow(pool) == 0) return(0)
  pattern <- paste(keywords, collapse = "|")
  matched <- pool[grepl(pattern, pool$term_name), ]
  if (nrow(matched) == 0) return(0)
  sum(-log10(matched$p_value))
}

shift_scores <- sapply(names(theme_keywords), function(theme) {
  up_score   <- score_theme(up_pool,   theme_keywords[[theme]])
  down_score <- score_theme(down_pool, theme_keywords[[theme]])
  up_score - down_score   # positive = net UP enrichment, negative = net DOWN
})

biology_shift <- data.frame(
  Theme = names(shift_scores),
  Score = as.numeric(shift_scores)
)

# Drop any theme with zero net signal (no matching terms on either side)
biology_shift <- biology_shift[biology_shift$Score != 0, ]

