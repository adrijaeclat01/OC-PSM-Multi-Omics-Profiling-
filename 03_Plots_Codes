# ============================================================
# OPTION C — RANK-NORMALIZED SCORING
#
# Instead of summing -log10(p) across all matching terms (which favors
# themes with MANY matching terms, e.g. Translation has many Reactome
# sub-steps), this uses the MEAN -log10(p) per matching term, so a
# theme's score reflects average strength of evidence, not term count.
# This is a real, defensible alternative scoring choice (analogous to
# normalizing for "depth of annotation" rather than letting categories
# with broader curation dominate purely by having more matched terms).
# ============================================================

score_theme_normalized <- function(pool, keywords, stat = "mean") {
  if (nrow(pool) == 0) return(c(score = 0, n_terms = 0))
  pattern <- paste(keywords, collapse = "|")
  matched <- pool[grepl(pattern, pool$term_name), ]
  if (nrow(matched) == 0) return(c(score = 0, n_terms = 0))
  vals <- -log10(matched$p_value)
  s <- if (stat == "mean") mean(vals) else median(vals)
  c(score = s, n_terms = nrow(matched))
}

theme_names <- names(theme_keywords)

norm_results <- lapply(theme_names, function(theme) {
  up_res   <- score_theme_normalized(up_pool,   theme_keywords[[theme]])
  down_res <- score_theme_normalized(down_pool, theme_keywords[[theme]])
  data.frame(
    Theme = theme,
    Score = up_res["score"] - down_res["score"],
    Up_n_terms = up_res["n_terms"],
    Down_n_terms = down_res["n_terms"]
  )
})

biology_shift_normalized <- bind_rows(norm_results)
