# STEP 2 (CORRECTED): FILTER + IMPUTE
# Fix from previous version: per-protein SD with only 2-3 real values
# is too unstable and produced negative (biologically impossible)
# imputed intensities. Fix: use a POOLED SD estimated across all
# proteins with reasonably good data (>=5 valid obs), apply it
# uniformly, and hard-clip any imputed value at a small positive floor.
# ============================================================

# datExpr0 should already be in your environment from Step 1 (corrected)
# If not: datExpr0 <- readRDS("datExpr0_raw_with_NAs.rds")

set.seed(42)

# --- 2a. Filter: keep proteins with >= 2 valid (non-NA) observations ---
valid_counts <- colSums(!is.na(datExpr0))
keep_proteins <- names(valid_counts)[valid_counts >= 2]
datExpr_filtered <- datExpr0[, keep_proteins]

cat("Proteins kept (>=2 valid observations):", length(keep_proteins), "\n\n")

# --- 2b. Estimate a POOLED standard deviation from well-measured proteins ---
# Use proteins with >=5 valid observations (out of 8) as the reference set -
# these have enough data points to give a trustworthy per-protein SD.
# We then take the MEDIAN of those SDs as a single pooled noise estimate,
# used for ALL proteins' imputation (regardless of how many obs they have).
# This avoids the instability of computing SD from just 2-3 points per protein.

well_measured <- names(valid_counts)[valid_counts >= 5]
cat("Proteins used to estimate pooled SD (>=5 valid obs):", length(well_measured), "\n")

per_protein_sd <- sapply(well_measured, function(p) {
  sd(datExpr_filtered[[p]], na.rm = TRUE)
})

pooled_sd <- median(per_protein_sd, na.rm = TRUE)
cat("Pooled SD estimate (median across well-measured proteins):", round(pooled_sd, 3), "\n\n")

# --- 2c. Imputation using pooled SD, with hard floor at zero ---
# Per-protein: use its OWN minimum observed value as the anchor (more
# robust than mean when n is tiny), downshift by a fixed amount in pooled-SD
# units, add jitter using the pooled SD (not protein's own unstable SD),
# and clip at a small positive floor so nothing goes negative.

downshift_factor <- 1.0   # how many pooled-SDs below the protein's own minimum
jitter_width     <- 0.3   # jitter SD as a fraction of pooled SD
floor_value      <- 0.01  # hard floor; adjust if your quantity scale differs

impute_protein <- function(x, pooled_sd, downshift_factor, jitter_width, floor_value) {
  observed <- x[!is.na(x)]
  if (length(observed) == 0) return(x)
  
  obs_min <- min(observed)
  impute_mean <- obs_min - downshift_factor * pooled_sd
  impute_sd   <- jitter_width * pooled_sd
  
  n_missing <- sum(is.na(x))
  imputed_vals <- rnorm(n_missing, mean = impute_mean, sd = impute_sd)
  imputed_vals <- pmax(imputed_vals, floor_value)  # hard floor, no negatives
  
  x[is.na(x)] <- imputed_vals
  return(x)
}

datExpr_imputed <- as.data.frame(lapply(
  datExpr_filtered, impute_protein,
  pooled_sd = pooled_sd, downshift_factor = downshift_factor,
  jitter_width = jitter_width, floor_value = floor_value
))
