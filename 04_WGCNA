# ============================================================
# STEP 3B: NETWORK CONSTRUCTION + MODULE DETECTION
# Comparing power = 1 vs power = 7 side by side before committing
# ============================================================

library(WGCNA)
options(stringsAsFactors = FALSE)

build_modules <- function(datExpr, power, minModuleSize = 20) {
  adjacency <- adjacency(datExpr, power = power, type = "signed")
  
  TOM <- TOMsimilarity(adjacency, TOMType = "signed")
  dissTOM <- 1 - TOM
  
  geneTree <- hclust(as.dist(dissTOM), method = "average")
  
  dynamicMods <- cutreeDynamic(dendro = geneTree, distM = dissTOM,
                               deepSplit = 2, pamRespectsDendro = FALSE,
                               minClusterSize = minModuleSize)
  dynamicColors <- labels2colors(dynamicMods)
  
  list(
    adjacency = adjacency,
    TOM = TOM,
    geneTree = geneTree,
    dynamicMods = dynamicMods,
    dynamicColors = dynamicColors,
    module_sizes = table(dynamicColors)
  )
}

cat("Building network with power = 1\n")
result_power1 <- build_modules(datExpr, power = 1)
cat("Module sizes (power=1):\n")
print(result_power1$module_sizes)

cat("Building network with power = 7\n")
result_power7 <- build_modules(datExpr, power = 7)
cat("Module sizes (power=7):\n")
print(result_power7$module_sizes)

pdf("module_dendrograms_comparison.pdf", width = 12, height = 6)
par(mfrow = c(1, 2))
plotDendroAndColors(result_power1$geneTree, result_power1$dynamicColors,
                    "Module colors", main = "Power = 1",
                    dendroLabels = FALSE, hang = 0.03,
                    addGuide = TRUE, guideHang = 0.05)
plotDendroAndColors(result_power7$geneTree, result_power7$dynamicColors,
                    "Module colors", main = "Power = 7",
                    dendroLabels = FALSE, hang = 0.03,
                    addGuide = TRUE, guideHang = 0.05)
dev.off()
cat("Saved module_dendrograms_comparison.pdf\n")


saveRDS(result_power1, "wgcna_result_power1.rds")
