# ============================================================
# STEP 4B: HUB GENE SCORING WITHIN TURQUOISE MODULE
# Eigenvector centrality on TOM-based adjacency,
# restricted to turquoise module members
# ============================================================

library(WGCNA)

if (!require("igraph")) {
  install.packages("igraph")
}
library(igraph)

# ------------------------------------------------------------
# 4e. Extract turquoise module members
# ------------------------------------------------------------
turquoise_proteins <- colnames(datExpr)[
  result_power7$dynamicColors == "turquoise"
]

cat("Number of proteins in turquoise module:",
    length(turquoise_proteins), "\n")

# ------------------------------------------------------------
# 4f. Subset the TOM to turquoise members only
# ------------------------------------------------------------
all_proteins <- colnames(datExpr)
turquoise_idx <- which(all_proteins %in% turquoise_proteins)

TOM_full <- result_power7$TOM
rownames(TOM_full) <- all_proteins
colnames(TOM_full) <- all_proteins

TOM_turquoise <- TOM_full[turquoise_idx, turquoise_idx]

cat("Turquoise sub-network TOM dimensions:",
    dim(TOM_turquoise)[1], "x",
    dim(TOM_turquoise)[2], "\n")

# ------------------------------------------------------------
# 4g. Build igraph network from the TOM submatrix
# Using TOM as edge weights
# ------------------------------------------------------------
diag(TOM_turquoise) <- 0

g_turquoise <- graph_from_adjacency_matrix(
  TOM_turquoise,
  mode = "undirected",
  weighted = TRUE,
  diag = FALSE
)

cat("Graph built:",
    vcount(g_turquoise), "nodes,",
    ecount(g_turquoise), "edges\n")

# ------------------------------------------------------------
# 4h. Eigenvector centrality
# ------------------------------------------------------------
eig_cent <- eigen_centrality(
  g_turquoise,
  weights = E(g_turquoise)$weight
)$vector

# ------------------------------------------------------------
# 4i. Intramodular connectivity (kWithin)
# Sum of TOM connection strengths to other module members
# ------------------------------------------------------------
kWithin <- rowSums(TOM_turquoise)

# ------------------------------------------------------------
# 4j. Combine into ranked hub table
# ------------------------------------------------------------
hub_table <- data.frame(
  Protein = names(eig_cent),
  EigenvectorCentrality = eig_cent,
  IntramodularConnectivity = kWithin[names(eig_cent)]
)

hub_table <- hub_table[
  order(-hub_table$EigenvectorCentrality),
]

hub_table$Rank_Eigenvector <- 1:nrow(hub_table)

hub_table$Rank_kWithin <- rank(
  -hub_table$IntramodularConnectivity,
  ties.method = "min"
)

# ------------------------------------------------------------
# Display top hubs
# ------------------------------------------------------------
cat("\n=== TOP 15 HUB PROTEINS (turquoise module, by eigenvector centrality) ===\n")

print(head(hub_table, 15))

