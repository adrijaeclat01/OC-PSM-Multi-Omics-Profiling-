# --- 2b. Minimum-value (Gaussian downshift) imputation ---
# For each protein: compute mean and SD of the OBSERVED values, then draw
# imputed values from a narrow normal distribution centered below the
# observed minimum (not at the minimum itself, to avoid creating an
# artificial pile-up of identical values, which can distort correlation
# structure in WGCNA).
#
# Standard parameters (consistent with Perseus-style downshift):
#   - downshift: 1.8 standard deviations below the protein's observed mean
#   - width: imputed values drawn with SD = 0.3 * observed SD
# These are conventional defaults in DIA-MS workflows (not arbitrary).

impute_protein <- function(x, downshift = 1.8, width = 0.3) {
  observed <- x[!is.na(x)]
  if (length(observed) < 2) return(x)  # safety net, shouldn't trigger post-filter
  
  obs_mean <- mean(observed)
  obs_sd   <- sd(observed)
  if (is.na(obs_sd) || obs_sd == 0) obs_sd <- 0.01 * abs(obs_mean)  # avoid zero-SD edge case
  
  impute_mean <- obs_mean - downshift * obs_sd
  impute_sd   <- width * obs_sd
  
  n_missing <- sum(is.na(x))
  x[is.na(x)] <- rnorm(n_missing, mean = impute_mean, sd = impute_sd)
  return(x)
}

