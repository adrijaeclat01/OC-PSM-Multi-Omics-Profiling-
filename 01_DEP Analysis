setwd("C:/Users/Adrija/Downloads")
list.files()
data <- read.delim("MetsPT_Candidates.tsv", 
                   header = TRUE, 
                   sep = "\t")
dim(data)
colnames(data)
data$Regulation <- "Not Significant"

data$Regulation[data$AVG.Log2.Ratio > 1 & data$Qvalue < 0.05] <- "Up"
data$Regulation[data$AVG.Log2.Ratio < -1 & data$Qvalue < 0.05] <- "Down"
table(data$Regulation)
library(ggplot2)

ggplot(data, aes(x = AVG.Log2.Ratio, 
                 y = -log10(Qvalue), 
                 color = Regulation)) +
  geom_point(alpha = 0.7, size = 2) +
  scale_color_manual(values = c("Up" = "red",
                                "Down" = "blue",
                                "Not Significant" = "grey")) +
  geom_vline(xintercept = c(-1, 1), linetype = "dashed") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
  theme_minimal() +
  labs(x = "Log2 Fold Change",
       y = "-Log10 Qvalue")
