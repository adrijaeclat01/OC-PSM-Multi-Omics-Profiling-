setwd("C:/Users/Adrija/Downloads")
list.files()
data <- read.delim("MetsPT_Candidates.tsv", 
                   header = TRUE, 
                   sep = "\t")

library(dplyr)

sig_proteins <- data %>%
  filter(
    Qvalue < 0.05,
    abs(AVG.Log2.Ratio) > 1
  )

dim(sig_proteins)

genes <- sig_proteins$Genes

genes <- genes[!is.na(genes)]
genes <- genes[genes != ""]

genes <- unlist(strsplit(genes, ";"))

genes <- trimws(genes)

genes <- unique(genes)

length(genes)

head(genes)

gene.df <- bitr(
  genes,
  fromType = "SYMBOL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

ego_bp <- enrichGO(
  gene = gene.df$ENTREZID,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID",
  ont = "BP",
  pAdjustMethod = "BH",
  pvalueCutoff = 0.05,
  qvalueCutoff = 0.05,
  readable = TRUE
)

ekegg <- enrichKEGG(
  gene = gene.df$ENTREZID,
  organism = "hsa"
)

ekegg <- setReadable(
  ekegg,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID"
)

class(ego_bp)

class(ekegg)

library(enrichplot)
library(ggplot2)

p_go <- dotplot(
  ego_bp,
  showCategory = 20,
  font.size = 12
) +
  ggtitle("GO Biological Processes") +
  theme_bw()

ggsave(
  "GO_BalloonPlot.png",
  p_go,
  width = 12,
  height = 8,
  dpi = 600,
  bg = "white"
)

